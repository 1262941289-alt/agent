# ================= 本地 Docker 部署示例配置 =================
# 复制为 .env 后填写真实值：  cp .env.example .env
# .env 已加入 .gitignore，切勿提交真实密钥。

# ---- 模型/LLM（必填） ----
# DeepSeek 示例：
AI_API_KEY=sk-your-deepseek-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ---- 备用模型通道（SiliconFlow）+ 账号池多 key（可选，主 key 熔断时降级） ----
SF_BASE_URL=https://api.siliconflow.cn
SF_API_KEY_1=sk-your-siliconflow-key-1
SF_API_KEY_2=sk-your-siliconflow-key-2
SF_API_KEY_3=sk-your-siliconflow-key-3

# ---- 数据库（必填，请用高强度随机口令） ----
MYSQL_ROOT_PASSWORD=<请替换为强随机口令>
MYSQL_USER=sk_app
MYSQL_PASSWORD=<请替换为强随机口令>

# ---- 可选：浏览器有头可视化调试（默认镜像内为无头 chromium）----
# SK_AGENT_BROWSER_HEADLESS=false
# SK_AGENT_BROWSER_CHANNEL=msedge